{
  "version": 2,
  "rewrites": [
    { "source": "/api/tools/:path*", "destination": "/api/tools" },
    { "source": "/api/suppliers/import", "destination": "/api/tools" },
    { "source": "/api/admin/tools/:path*", "destination": "/api/tools" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    },
    "api/tools.js": {
      "maxDuration": 60
    }
  }
}
